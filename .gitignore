# ============================================================
# AutoBook .gitignore
# 原则：业务源码、README.md、构建脚本和图标源图入库；
#       其他文档、测试文件、规划与验证记录仅在本地保留。
#       构建产物、缓存、本机配置、密钥及个人媒体不入库。
# ============================================================

# ---------- 1. 构建产物 ----------
build/
*/build/
.gradle/
.kotlin/
captures/
*.hprof

# 打包产物（安装包不入库，历史交付放 runs/deliverables 本地留档）
*.apk
*.aab
*.ap_
*.zip
*.jar
# 例外：Gradle Wrapper 的 jar 必须入库，否则别人无法用 ./gradlew
!gradle/wrapper/gradle-wrapper.jar
# 例外：本地预置 AAR（上游未发布到 Maven，构建必需）
!app/libs/*.aar

# dist 下只保留目录本身，安装包不入库
dist/*
!dist/.gitkeep

# ---------- 2. 本机配置 ----------
# 含本机 SDK 绝对路径，每台机器不同
local.properties
# 签名口令与密钥，绝不入库
keystore.properties
*.jks
*.keystore
*.p12
*.pem
*.key
.env
.env.*

# ---------- 3. 缓存与临时文件 ----------
*.pyc
__pycache__/
*.tmp
*.bak
*.orig
*.rej
*~
.DS_Store
Thumbs.db

# ---------- 4. IDE / 工具 ----------
.idea/
*.iml
.vscode/
.settings/
.project
.classpath

# ---------- 5. 体积大且与源码无关的材料 ----------
# 第三方 App / Root 工具的安装包，仅本地参考
iCost.apk
tmp/

# 个人截图与录屏（含交易页面，避免隐私外泄；如作规则样本请先脱敏）
截图/

# ---------- 6. 文档、计划与测试（只留本地） ----------
# 文档仅保留仓库根目录的 README.md；不删除本地文件。
*.md
*.MD
!README.md

# docs/ 全部只留本地：不再纳入版本库（含 docs/README.md），
# 需写在 /README.md 之后再声明，否则会被上面的 !README.md 重新放行。
/docs/

# OpenSpec 规划、测试记录、交付快照和临时验证脚本
openspec/
runs/
deliverables/
scratch/

# 各模块单元/设备测试源码、资源及 fixtures
**/src/test/
**/src/androidTest/
**/src/testFixtures/
/tests/
/test-results/
/coverage/

# ---------- 7. 沙箱挂载的占位文件（非项目内容） ----------
/.bash_profile
/.bashrc
/.profile
/.zprofile
/.zshrc
/.gitconfig
/.gitmodules
/.ripgreprc
/.mcp.json
/.claude/
/.idea
/.vscode

# 本地委派/测试产生的可重建Gradle缓存（保留本地，不入库）
.dsh-gradle-home/
.gradle-home-test/

# 本轮本地临时工作目录（图标素材下载、探针输出、专用 Gradle 缓存，可重建）
.gradle-user/
.tmp-icons/
.tmp-probe/
.dsh-write-test
