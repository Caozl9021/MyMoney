# ============================================================
# 麦米 My Money .gitignore
# 原则：业务源码、README.md、构建脚本和图标源图入库；
#       其他文档、测试文件、规划与验证记录仅在本地保留。
#       构建产物、缓存、本机配置、密钥及个人媒体不入库。
# ============================================================

# ---------- 1. 构建产物 ----------
build/
*/build/
.gradle/
.kotlin/
captures/
*.hprof

# 打包产物（安装包不入库，历史交付放 runs/deliverables 本地留档）
*.apk
*.aab
*.ap_
*.zip
*.jar
# 例外：Gradle Wrapper 的 jar 必须入库，否则别人无法用 ./gradlew
!gradle/wrapper/gradle-wrapper.jar
# 例外：本地预置 AAR（上游未发布到 Maven，构建必需）
!app/libs/*.aar

# dist 下只保留目录本身，安装包不入库
dist/*
!dist/.gitkeep

# ---------- 2. 本机配置 ----------
# 含本机 SDK 绝对路径，每台机器不同
local.properties
# 签名口令与密钥，绝不入库
keystore.properties
*.jks
*.keystore
*.p12
*.pem
*.key
.env
.env.*

# ---------- 3. 缓存与临时文件 ----------
*.pyc
__pycache__/
*.tmp
*.bak
*.orig
*.rej
*~
.DS_Store
Thumbs.db

# ---------- 4. IDE / 工具 ----------
.idea/
*.iml
.vscode/
.settings/
.project
.classpath

# ---------- 5. 体积大且与源码无关的材料 ----------
# 第三方 App / Root 工具的安装包，仅本地参考
iCost.apk
tmp/

# 个人截图与录屏（含交易页面，避免隐私外泄；如作规则样本请先脱敏）
截图/

# ---------- 6. 文档与内部记录 ----------
# 根目录只放行面向社区的文档，其余 Markdown 仍只留本地。
*.md
*.MD
!/README.md
!/CHANGELOG.md
!/CONTRIBUTING.md
!/SECURITY.md
!/CODE_OF_CONDUCT.md
!/ARCHITECTURE.md

# 本地 vendored 依赖与第三方资产的来源说明需要入库
!/app/libs/*.md
!/app/src/main/assets/licenses/**/*.md

# GitHub 协作模板需要入库
!/.github/**/*.md

# docs/ 只放行面向用户的专题文档；内部进度、计划与分支说明仍只留本地。
# 注意：例外必须写在忽略规则之后，否则会被上面的通配重新覆盖。
/docs/*
!/docs/README.md
!/docs/LOCAL_RULES.md
!/docs/UI_COMPONENTS.md
!/docs/ASSET_MANAGEMENT.md
!/docs/LEDGER_MONTH_PERIOD.md
!/docs/ICOST_IMPORT.md
!/docs/QIANJI_IMPORT.md
!/docs/LSP_MODULE.md

# 内部规划、交付快照、验证记录与交接文档
openspec/
runs/
deliverables/
scratch/
/AGENTS.md
/agent.md
/PROGRESS.md
/PLAN_1.0.md
/QUICKREF.md
/DEPLOYMENT.md
/docs/PROGRESS.md
/docs/PLAN_1.0.md
/docs/SELF_BRANCH.md
/docs/ROOT_PLAN.md

# ---------- 7. 测试（源码入库，产物不入库） ----------
# 单元测试与设备测试源码、脱敏 fixtures 均入库，便于他人复现。
**/src/testFixtures/
/tests/
/test-results/
/coverage/

# ---------- 7. 沙箱挂载的占位文件（非项目内容） ----------
/.bash_profile
/.bashrc
/.profile
/.zprofile
/.zshrc
/.gitconfig
/.gitmodules
/.ripgreprc
/.mcp.json
/.claude/
/.idea
/.vscode

# 本地委派/测试产生的可重建Gradle缓存（保留本地，不入库）
.dsh-gradle-home/
.gradle-home-test/

# 本轮本地临时工作目录（图标素材下载、探针输出、专用 Gradle 缓存，可重建）
.gradle-user/
.tmp-icons/
.tmp-probe/
.dsh-write-test
