# PostgreSQL：填写自己的数据库地址和专用运行角色；schema 与其他业务隔离
MYMONEY_DATABASE_URL=postgresql://mymoney_app:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:5432/mymoney
MYMONEY_DB_SCHEMA=mymoney_home
MYMONEY_BACKUP_DIR=/srv/mymoney-home/backups
MYMONEY_PORT=8080
MYMONEY_ADMIN_TOKEN=REPLACE_WITH_RANDOM_ADMIN_TOKEN
# 可选：配对码；不设置时通过 admin 接口生成随机短期码
# MYMONEY_PAIRING_CODE=REPLACE_WITH_RANDOM_PAIRING_CODE
# 配对码有效期秒数；0 = 永久有效且可重复配对（仅建议家庭内网使用）
MYMONEY_PAIRING_TTL_SECONDS=300
MYMONEY_BASE_URL=http://127.0.0.1:8080
