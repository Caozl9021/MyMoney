<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <permission android:name="com.example.autobook.permission.LSP_PROBE" android:protectionLevel="signature" />
    <uses-permission android:name="com.example.autobook.permission.LSP_PROBE" />

    <!-- 记录类 App 不需要联网；如果以后要同步，再加 INTERNET -->
    <!-- 悬浮确认卡片（root 路径下唯一不受后台启动限制的弹窗方式） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- root 轮询常驻：把采集跑在前台服务里，避免"离开设置页就停" -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!--
      用 specialUse 而不是 dataSync：dataSync 在 Android 15 上有 6 小时/天 的上限，
      且不允许从 BOOT_COMPLETED 拉起 —— 常驻监听会被系统掐掉。
      specialUse 需要在 service 里写 PROPERTY_SPECIAL_USE_FGS_SUBTYPE 说明用途。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 开机后恢复 root 轮询 / 无障碍守护（仅当用户自己开启过） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
      无障碍守护会引导用户把本 App 加入电池优化白名单。
      只有用户主动点「保活体检」里的按钮才会跳这个系统对话框，不会偷偷弹。
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      Android 11+ 包可见性：不声明 queries 的话
      getPackageInfo("com.gostraight...") 会抛 NameNotFound，
      导至「导入 iCost」按钮永远不显示 / 定向分享失败。
    -->
    <queries>
        <package android:name="com.gostraight.smallAccountBook.fltandroid" />
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/csv" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AutoBook">

        <provider
            android:name=".lsp.LspStatusProvider"
            android:authorities="com.example.autobook.lsp.status"
            android:exported="true"
            android:grantUriPermissions="false" />

        <!-- Xposed 模块元数据（内置 LSP 增强功能） -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="系统连接诊断与有限后台终止保护（可选功能）" />
        <meta-data
            android:name="xposedminversion"
            android:value="93" />

        <activity android:name=".ui.BillResultActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.MainActivity"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <service
            android:name=".systems.RecognitionTileService"
            android:exported="true"
            android:icon="@drawable/ic_brand_small"
            android:label="@string/recognition_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true" />
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>

        <receiver android:name=".systems.MonthlyExpenseWidget" android:exported="false"
            android:label="@string/monthly_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/monthly_expense_widget" />
        </receiver>

        <!-- 确认页：不导出、不进最近任务、只有一行确认 -->
        <activity
            android:name=".ui.ConfirmActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.AutoBook.Translucent" />

        <!-- root 轮询常驻服务（用户手动开启后才启动） -->
        <service
            android:name=".root.RootForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="root 模式下按固定节拍读取当前界面文字，用于生成本地账单草稿（个人自用，不联网）" />
        </service>

        <!--
          无障碍守护：无障碍模式下每 30s 检查一次服务还在不在，掉了发提醒。
          它是前台服务（specialUse），所以在通知栏有一条常驻的低优先级通知。
        -->
        <service
            android:name=".capture.AccessibilityGuardian"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="无障碍模式下周期检查本应用的无障碍服务是否被系统或厂商关闭，必要时提醒用户重新开启（个人自用，不联网）" />
        </service>

        <!-- 开机/更新后恢复 root 轮询 -->
        <receiver
            android:name=".root.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 导出 CSV → 分享给 iCost（走它公开的 ShareReceiveActivity 导入入口） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          无障碍服务：诚实申报
          - isAccessibilityTool=false
          - 不申请 canRequestFilterKeyEvents / flagRetrieveInteractiveWindows
          - notificationTimeout 用来降低回调频率（系统层节流，省电）
        -->
        <service
            android:name=".capture.BillAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>
</manifest>
