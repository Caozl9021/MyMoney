<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 家庭同步允许私网/回环及 Tailscale (100.64.0.0/10) 明文 HTTP；公网地址仍要求 HTTPS。 -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
