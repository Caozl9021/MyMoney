<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="3dp"
    android:paddingTop="15dp"
    android:paddingBottom="0dp">

    <LinearLayout
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_background_glass_dark"
        android:orientation="vertical"
        android:paddingHorizontal="11dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginEnd="5dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_brand_color" />

            <TextView
                android:id="@+id/widget_seven_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="近 7 日"
                android:textColor="@color/widget_secondary"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/widget_eye"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:padding="3dp"
                android:src="@drawable/ic_widget_eye_on" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_seven_total"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autoSizeMaxTextSize="18sp"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:maxLines="1"
            android:text="¥0.00"
            android:textColor="@color/widget_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/widget_seven_chart"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="3dp"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />
    </LinearLayout>
</FrameLayout>
