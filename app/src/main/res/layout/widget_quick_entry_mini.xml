<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="麦米极速记账，轻点记一笔"
    android:paddingHorizontal="3dp"
    android:paddingTop="14dp"
    android:paddingBottom="0dp">

    <FrameLayout
        android:id="@+id/widget_card"
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:layout_gravity="bottom|center_horizontal"
        android:background="@drawable/widget_background_glass_dark">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_brand_color" />

        <FrameLayout
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="5dp">

            <ImageView
                android:id="@+id/widget_quick_add_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_accent_circle" />

            <ImageView
                android:id="@+id/widget_quick_add_icon"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_add" />
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
