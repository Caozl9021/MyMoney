<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="3dp"
    android:paddingTop="15dp"
    android:paddingBottom="0dp">

    <LinearLayout
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_background_glass_dark"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="5dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_brand_color" />

            <TextView
                android:id="@+id/widget_primary_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="净资产"
                android:textColor="@color/widget_secondary"
                android:textSize="11.5sp" />

            <ImageView
                android:id="@+id/widget_tune"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginTop="-6dp"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="-6dp"
                android:contentDescription="配置小组件"
                android:padding="9dp"
                android:src="@drawable/ic_widget_tune" />

            <ImageView
                android:id="@+id/widget_eye"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginTop="-6dp"
                android:layout_marginEnd="-6dp"
                android:layout_marginBottom="-6dp"
                android:padding="9dp"
                android:src="@drawable/ic_widget_eye_on" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_primary_block"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_primary_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoSizeMaxTextSize="22sp"
                android:autoSizeMinTextSize="14sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:text="¥0.00"
                android:textColor="@color/widget_primary"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_primary_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:text="总资产 ¥0.00"
                android:textColor="@color/widget_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_middle_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/widget_surface_pill"
            android:orientation="vertical"
            android:paddingHorizontal="9dp"
            android:paddingVertical="6dp">

            <TextView
                android:id="@+id/widget_middle_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="总负债"
                android:textColor="@color/widget_secondary"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/widget_middle_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:autoSizeMaxTextSize="13sp"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:text="¥0.00"
                android:textColor="@color/widget_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/widget_secondary_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="34dp">

            <ImageView
                android:id="@+id/widget_secondary_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_accent_pill" />

            <TextView
                android:id="@+id/widget_secondary_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:paddingHorizontal="9dp"
                android:paddingVertical="7dp"
                android:text="待报销 · 0 笔"
                android:textColor="@color/widget_primary"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
